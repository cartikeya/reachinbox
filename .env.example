# Runtime
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string
ALLOW_DEMO_AUTH=true

# PostgreSQL / Redis / Elasticsearch
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox
PGSSLMODE=disable
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# BullMQ worker tuning
WORKER_CONCURRENCY=8
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
WORKER_STALE_MS=900000

# Ethereal SMTP (optional: if omitted, a test account is created automatically)
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
DEFAULT_SENDER_EMAIL=reachinbox.demo@ethereal.email
SENDER_EMAILS=reachinbox.demo@ethereal.email,secondary.demo@ethereal.email

# Google OAuth (required for real login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Slack OAuth (required for live Slack notifications)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/slack/callback
SLACK_SCOPES=chat:write
